{
  "schema": 1,
  "asset_name": "KarenBot-Windows-x64.zip",
  "description": "KarenBot Windows 原生 GTK4 GUI 便携包契约；由安装器仓库的 Windows 打包流水线产出并附加到安装器 Release，安装器下载、校验和安装。",
  "required_dirs": [
    "backend",
    "gui"
  ],
  "python_candidates": [
    "runtime/python.exe",
    "runtime/bin/python.exe",
    "python.exe"
  ],
  "required_dlls": [
    "libgtk-4-1.dll",
    "libadwaita-1-0.dll",
    "libgobject-2.0-0.dll"
  ],
  "typelib_dirs": [
    "runtime/lib/girepository-1.0",
    "lib/girepository-1.0"
  ],
  "required_typelibs": [
    "Gtk-4.0.typelib",
    "Adw-1.typelib"
  ],
  "runtime_env": {
    "PATH": "runtime/bin",
    "XDG_DATA_DIRS": "runtime/share",
    "GI_TYPELIB_PATH": "runtime/lib/girepository-1.0",
    "GSETTINGS_SCHEMA_DIR": "runtime/share/glib-2.0/schemas",
    "GTK_DATA_PREFIX": "runtime",
    "GTK_EXE_PREFIX": "runtime"
  },
  "launcher": "runtime/pythonw.exe -m gui",
  "font_env": "FONTCONFIG_FILE=%LOCALAPPDATA%\\KarenBot\\fonts\\fonts.conf",
  "theme_preference": "%APPDATA%\\karen-gui\\skin 或 %LOCALAPPDATA%\\karen-gui\\skin",
  "renderer_fallback": {
    "auto": "由 gui.launcher 在导入 GTK 前按 stage 回退",
    "cairo": "KAREN_GUI_RENDERER=cairo, GSK_RENDERER=cairo, GDK_DEBUG=gl-disable, LIBGL_ALWAYS_SOFTWARE=1"
  }
}
